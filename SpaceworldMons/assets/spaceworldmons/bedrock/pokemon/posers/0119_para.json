{
    "portraitScale": 2,
    "portraitTranslation": [0, -0.2, 0],
    "profileScale": 1.3,
    "profileTranslation": [0, -0.2, 0],
	"rootBone": "para",
    "animations": {
        "cry": "q.bedrock_stateful('para', 'twitch')",
        "recoil": "q.bedrock_stateful('para', 'twitch')",
        "faint": "q.bedrock_stateful('para', 'twitch')"
    },
    "poses": {
        "standing": {
            "poseName": "standing",
            "poseTypes": ["STAND", "FLOAT", "NONE", "PORTRAIT", "PROFILE"],
            "isBattle": false,
            "condition": "!q.in_air",
            "animations": [
				"q.look('head')",
                "q.bedrock('para', 'ground_idle')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('para', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('para', 'twitch')"
            ]
        },
        "battle-standing": {
            "poseName": "battle_standing",
            "poseTypes": ["STAND"],
            "isBattle": true,
            "animations": [
				"q.look('head')",
                "q.bedrock('para', 'ground_idle')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('para', 'hold_item')"
                }
            ],
            "quirks": [
                "q.bedrock_quirk('para', 'twitch')"
            ]
        },
        "walking": {
            "poseName": "walking",
            "poseTypes": ["WALK", "SWIM"],
            "isBattle": false,
            "condition": "!q.in_air && !q.is_sprinting",
            "animations": [
				"q.look('head')",
                "q.bedrock('para', 'ground_walk')",
                {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('para', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('para', 'twitch')"
            ]
        }
    }
}