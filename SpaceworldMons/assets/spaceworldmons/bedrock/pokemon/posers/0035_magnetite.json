{
    "portraitScale": 1.2,
    "portraitTranslation": [0.1, 0.5, 0],
    "profileScale": 0.8,
    "profileTranslation": [0, 0.5, 0],
	"rootBone": "magnetite",
    "animations": {
        "cry": "q.bedrock_stateful('magnetite', 'cry')",
		"recoil": "q.bedrock_stateful('magnetite', 'blink')",
        "faint": "q.bedrock_stateful('magnetite', 'faint')"
    },
    "poses": {
        "standing": {
            "poseName": "standing",
            "poseTypes": ["STAND", "FLOAT", "NONE", "PORTRAIT", "PROFILE"],
            "isBattle": false,
            "condition": "!q.in_air",
            "animations": [
                "q.look('body')",
                "q.bedrock('magnetite', 'ground_idle')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('magnetite', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('magnetite', 'blink')"
            ]
        },
        "battle-standing": {
            "poseName": "battle_standing",
            "poseTypes": ["STAND"],
            "isBattle": true,
            "animations": [
                "q.look('body')",
                "q.bedrock('magnetite', 'ground_idle')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('magnetite', 'hold_item')"
                }
            ],
            "quirks": [
                "q.bedrock_quirk('magnetite', 'blink')"
            ]
        },
        "walking": {
            "poseName": "walking",
            "poseTypes": ["WALK", "SWIM"],
            "isBattle": false,
            "condition": "!q.in_air && !q.is_sprinting",
            "animations": [
                "q.look('body')",
                "q.bedrock('magnetite', 'ground_walk')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('magnetite', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('magnetite', 'blink')"
            ]
        },
        "hovering": {
            "poseName": "hovering",
            "poseTypes": ["HOVER"],
            "isBattle": false,
            "animations": [
                "q.look('body')",
                "q.bedrock('magnetite', 'air_idle')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('magnetite', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('magnetite', 'blink')"
            ]
        },
        "flying": {
            "poseName": "flying",
            "poseTypes": ["FLY"],
            "isBattle": false,
            "animations": [
                "q.look('body')",
                "q.bedrock('magnetite', 'air_fly')", {
                    "condition": "q.is_holding_item",
                    "animation": "q.bedrock('magnetite', 'hold_item')"
                }
            ],
            "transformTicks": 10,
            "quirks": [
                "q.bedrock_quirk('magnetite', 'blink')"
            ]
        },
        "sleeping": {
            "poseName": "sleeping",
            "poseTypes": ["SLEEP"],
            "animations": [
                "q.bedrock('magnetite', 'sleep')"
            ],
            "transformTicks": 10
        }
    }
}